<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.expensewise">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MadProject">

        <activity
            android:name="com.example.expensewise.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MadProject">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.expensewise.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.expensewise.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.expensewise.PinLockActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.expensewise.SettingsActivity"
            android:exported="false" />

        <activity
            android:name="com.example.expensewise.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.expensewise.AddTransactionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.expensewise.TransactionDetailsActivity"
            android:exported="false" />

        <activity
            android:name="com.example.expensewise.AddBudgetActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.expensewise.SavingsGoalsActivity"
            android:exported="false" />

        <activity
            android:name="com.example.expensewise.AddSavingsGoalActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.expensewise.RecurringExpensesActivity"
            android:exported="false" />

        <activity
            android:name="com.example.expensewise.AddRecurringExpenseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name="com.example.expensewise.utils.NotificationReceiver"
            android:exported="false" />

    </application>

</manifest>